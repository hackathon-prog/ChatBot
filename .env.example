# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Local sample (SQLite) ----
DATABASE_URL=sqlite:///lms.db
REQUIRE_AUTH=false

# ---- Real LMS (Supabase Postgres, analytics views) ----
# Run supabase_analytics.sql in the Supabase SQL Editor, set a password for role analytics_ro, then use the
# Session pooler connection string from Supabase (Connect button) with the analytics_ro user:
# DATABASE_URL=postgresql+psycopg://analytics_ro.<project-ref>:<password>@<pooler-host>:5432/postgres
# DB_SCHEMA=analytics
# REQUIRE_AUTH=true
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<the public anon key only, never the service_role key>
# CORS_ORIGINS=http://localhost:5173,https://<your-app>.vercel.app

BLOCKED_COLUMNS=email,password,password_hash,phone,address,user_id,display_name,body
MAX_ROWS=200
REQUESTS_PER_MINUTE=12
